# Postgres (Neon / Supabase / Vercel Postgres). Needed by BetterAuth.
DATABASE_URL=postgres://user:password@host/db?sslmode=require

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me
# Your site URL (http://localhost:3000 locally, your Vercel URL in production)
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional: override API base
# API_BASE_1=https://api.api-store.workers.dev/api/bazardor
# API_BASE_2=https://api.abcz.workers.dev/api/bazardor
